@startuml
skinparam classAttributeIconSize 0
class ExcelDB {
  +path: Path
  +create_order(client_id, branch_id, items, observation)
  +order_details(order_id)
  +finalize_order(order_id)
  +cancel_order(order_id)
  +delete_order(order_id)
}
class DataError <<exception>>
ExcelDB ..> DataError : sinaliza erros
class Produto <<registro lógico>> {
  +id: int
  +nome: str
  +descricao: str
  +categoria: str
  +preco: float
  +estoque: int
  +id_fornecedor: int
  +ativo: bool
  +criado_em: str
}
class Cliente <<registro lógico>> {
  +id: int
  +nome: str
  +cpf: str
  +telefone: str
  +email: str
  +endereco: str
  +ativo: bool
  +criado_em: str
}
class Fornecedor <<registro lógico>> {
  +id: int
  +nome: str
  +cnpj: str
  +telefone: str
  +email: str
  +endereco: str
  +ativo: bool
  +criado_em: str
}
class Filial <<registro lógico>> {
  +id: int
  +nome: str
  +cnpj: str
  +telefone: str
  +endereco: str
  +cidade: str
  +uf: str
  +ativo: bool
  +criado_em: str
}
class Pedido <<registro lógico>> {
  +id: int
  +numero: str
  +id_cliente: int
  +id_filial: int
  +data_pedido: str
  +status: str
  +total: float
  +observacao: str
  +efetivado_em: str
}
class ItemPedido <<registro lógico>> {
  +id: int
  +id_pedido: int
  +id_produto: int
  +quantidade: int
  +preco_unitario: float
  +subtotal: float
}
class Configuracao <<registro lógico>> {
  +chave: str
  +valor: str
  +descricao: str
}
ExcelDB ..> Pedido : persiste
ExcelDB ..> Configuracao : carrega
Fornecedor "0..1" -- "0..*" Produto : fornece
Cliente "1" -- "0..*" Pedido : realiza
Filial "1" -- "0..*" Pedido : recebe
Pedido "1" *-- "1..*" ItemPedido : contém
Produto "1" -- "0..*" ItemPedido : referencia
@enduml
