digraph {
    graph [label="Lanchonete Ágil | Modelo entidade-relacionamento" labelloc=t fontsize=22 fontname="DejaVu Sans" pad=0.3 nodesep=0.45 ranksep=0.8];
    node [fontname="DejaVu Sans" fontsize=10 color="#536277"];
    edge [fontname="DejaVu Sans" fontsize=9 color="#536277" dir=none];
    graph [rankdir=TB];
Produtos [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>Produtos</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR><TR><TD ALIGN="LEFT">     nome</TD></TR><TR><TD ALIGN="LEFT">     descricao</TD></TR><TR><TD ALIGN="LEFT">     categoria</TD></TR><TR><TD ALIGN="LEFT">     preco</TD></TR><TR><TD ALIGN="LEFT">     estoque</TD></TR><TR><TD ALIGN="LEFT">FK  id_fornecedor</TD></TR><TR><TD ALIGN="LEFT">     ativo</TD></TR><TR><TD ALIGN="LEFT">     criado_em</TD></TR></TABLE>>];
Clientes [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>Clientes</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR><TR><TD ALIGN="LEFT">     nome</TD></TR><TR><TD ALIGN="LEFT">     cpf</TD></TR><TR><TD ALIGN="LEFT">     telefone</TD></TR><TR><TD ALIGN="LEFT">     email</TD></TR><TR><TD ALIGN="LEFT">     endereco</TD></TR><TR><TD ALIGN="LEFT">     ativo</TD></TR><TR><TD ALIGN="LEFT">     criado_em</TD></TR></TABLE>>];
Fornecedores [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>Fornecedores</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR><TR><TD ALIGN="LEFT">     nome</TD></TR><TR><TD ALIGN="LEFT">     cnpj</TD></TR><TR><TD ALIGN="LEFT">     telefone</TD></TR><TR><TD ALIGN="LEFT">     email</TD></TR><TR><TD ALIGN="LEFT">     endereco</TD></TR><TR><TD ALIGN="LEFT">     ativo</TD></TR><TR><TD ALIGN="LEFT">     criado_em</TD></TR></TABLE>>];
Filiais [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>Filiais</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR><TR><TD ALIGN="LEFT">     nome</TD></TR><TR><TD ALIGN="LEFT">     cnpj</TD></TR><TR><TD ALIGN="LEFT">     telefone</TD></TR><TR><TD ALIGN="LEFT">     endereco</TD></TR><TR><TD ALIGN="LEFT">     cidade</TD></TR><TR><TD ALIGN="LEFT">     uf</TD></TR><TR><TD ALIGN="LEFT">     ativo</TD></TR><TR><TD ALIGN="LEFT">     criado_em</TD></TR></TABLE>>];
Pedidos [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>Pedidos</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR><TR><TD ALIGN="LEFT">     numero</TD></TR><TR><TD ALIGN="LEFT">FK  id_cliente</TD></TR><TR><TD ALIGN="LEFT">FK  id_filial</TD></TR><TR><TD ALIGN="LEFT">     data_pedido</TD></TR><TR><TD ALIGN="LEFT">     status</TD></TR><TR><TD ALIGN="LEFT">     total</TD></TR><TR><TD ALIGN="LEFT">     observacao</TD></TR><TR><TD ALIGN="LEFT">     efetivado_em</TD></TR></TABLE>>];
ItensPedido [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>ItensPedido</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR><TR><TD ALIGN="LEFT">FK  id_pedido</TD></TR><TR><TD ALIGN="LEFT">FK  id_produto</TD></TR><TR><TD ALIGN="LEFT">     quantidade</TD></TR><TR><TD ALIGN="LEFT">     preco_unitario</TD></TR><TR><TD ALIGN="LEFT">     subtotal</TD></TR></TABLE>>];
Configuracoes [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>Configuracoes</B></TD></TR><TR><TD ALIGN="LEFT">PK  chave</TD></TR><TR><TD ALIGN="LEFT">     valor</TD></TR><TR><TD ALIGN="LEFT">     descricao</TD></TR></TABLE>>];
Fornecedores -> Produtos [taillabel="0..1" headlabel="0..*" labeldistance=1.6 label="id_fornecedor"];
Clientes -> Pedidos [taillabel="1" headlabel="0..*" labeldistance=1.6 label="id_cliente"];
Filiais -> Pedidos [taillabel="1" headlabel="0..*" labeldistance=1.6 label="id_filial"];
Pedidos -> ItensPedido [taillabel="1" headlabel="1..*" labeldistance=1.6 label="id_pedido"];
Produtos -> ItensPedido [taillabel="1" headlabel="0..*" labeldistance=1.6 label="id_produto"];
    }
