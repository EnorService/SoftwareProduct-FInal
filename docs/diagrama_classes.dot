digraph {
    graph [label="Lanchonete Ágil | Diagrama de classes" labelloc=t fontsize=22 fontname="DejaVu Sans" pad=0.3 nodesep=0.45 ranksep=0.8];
    node [fontname="DejaVu Sans" fontsize=10 color="#536277"];
    edge [fontname="DejaVu Sans" fontsize=9 color="#536277" dir=none];
    graph [rankdir=TB];
Produto [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#FFF2BE" CELLPADDING="8"><B>«registro lógico» Produto</B></TD></TR><TR><TD ALIGN="LEFT">+id: int</TD></TR><TR><TD ALIGN="LEFT">+nome: str</TD></TR><TR><TD ALIGN="LEFT">+descricao: str</TD></TR><TR><TD ALIGN="LEFT">+categoria: str</TD></TR><TR><TD ALIGN="LEFT">+preco: float</TD></TR><TR><TD ALIGN="LEFT">+estoque: int</TD></TR><TR><TD ALIGN="LEFT">+id_fornecedor: int</TD></TR><TR><TD ALIGN="LEFT">+ativo: bool</TD></TR><TR><TD ALIGN="LEFT">+criado_em: str</TD></TR></TABLE>>];
Cliente [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#FFF2BE" CELLPADDING="8"><B>«registro lógico» Cliente</B></TD></TR><TR><TD ALIGN="LEFT">+id: int</TD></TR><TR><TD ALIGN="LEFT">+nome: str</TD></TR><TR><TD ALIGN="LEFT">+cpf: str</TD></TR><TR><TD ALIGN="LEFT">+telefone: str</TD></TR><TR><TD ALIGN="LEFT">+email: str</TD></TR><TR><TD ALIGN="LEFT">+endereco: str</TD></TR><TR><TD ALIGN="LEFT">+ativo: bool</TD></TR><TR><TD ALIGN="LEFT">+criado_em: str</TD></TR></TABLE>>];
Fornecedor [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#FFF2BE" CELLPADDING="8"><B>«registro lógico» Fornecedor</B></TD></TR><TR><TD ALIGN="LEFT">+id: int</TD></TR><TR><TD ALIGN="LEFT">+nome: str</TD></TR><TR><TD ALIGN="LEFT">+cnpj: str</TD></TR><TR><TD ALIGN="LEFT">+telefone: str</TD></TR><TR><TD ALIGN="LEFT">+email: str</TD></TR><TR><TD ALIGN="LEFT">+endereco: str</TD></TR><TR><TD ALIGN="LEFT">+ativo: bool</TD></TR><TR><TD ALIGN="LEFT">+criado_em: str</TD></TR></TABLE>>];
Filial [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#FFF2BE" CELLPADDING="8"><B>«registro lógico» Filial</B></TD></TR><TR><TD ALIGN="LEFT">+id: int</TD></TR><TR><TD ALIGN="LEFT">+nome: str</TD></TR><TR><TD ALIGN="LEFT">+cnpj: str</TD></TR><TR><TD ALIGN="LEFT">+telefone: str</TD></TR><TR><TD ALIGN="LEFT">+endereco: str</TD></TR><TR><TD ALIGN="LEFT">+cidade: str</TD></TR><TR><TD ALIGN="LEFT">+uf: str</TD></TR><TR><TD ALIGN="LEFT">+ativo: bool</TD></TR><TR><TD ALIGN="LEFT">+criado_em: str</TD></TR></TABLE>>];
Pedido [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#FFF2BE" CELLPADDING="8"><B>«registro lógico» Pedido</B></TD></TR><TR><TD ALIGN="LEFT">+id: int</TD></TR><TR><TD ALIGN="LEFT">+numero: str</TD></TR><TR><TD ALIGN="LEFT">+id_cliente: int</TD></TR><TR><TD ALIGN="LEFT">+id_filial: int</TD></TR><TR><TD ALIGN="LEFT">+data_pedido: str</TD></TR><TR><TD ALIGN="LEFT">+status: str</TD></TR><TR><TD ALIGN="LEFT">+total: float</TD></TR><TR><TD ALIGN="LEFT">+observacao: str</TD></TR><TR><TD ALIGN="LEFT">+efetivado_em: str</TD></TR></TABLE>>];
ItemPedido [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#FFF2BE" CELLPADDING="8"><B>«registro lógico» ItemPedido</B></TD></TR><TR><TD ALIGN="LEFT">+id: int</TD></TR><TR><TD ALIGN="LEFT">+id_pedido: int</TD></TR><TR><TD ALIGN="LEFT">+id_produto: int</TD></TR><TR><TD ALIGN="LEFT">+quantidade: int</TD></TR><TR><TD ALIGN="LEFT">+preco_unitario: float</TD></TR><TR><TD ALIGN="LEFT">+subtotal: float</TD></TR></TABLE>>];
Configuracao [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#FFF2BE" CELLPADDING="8"><B>«registro lógico» Configuracao</B></TD></TR><TR><TD ALIGN="LEFT">+chave: str</TD></TR><TR><TD ALIGN="LEFT">+valor: str</TD></TR><TR><TD ALIGN="LEFT">+descricao: str</TD></TR></TABLE>>];
ExcelDB [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>ExcelDB</B></TD></TR><TR><TD ALIGN="LEFT">+path: Path</TD></TR><TR><TD ALIGN="LEFT">+create_order(client_id, branch_id, items, observation)</TD></TR><TR><TD ALIGN="LEFT">+order_details(order_id)</TD></TR><TR><TD ALIGN="LEFT">+finalize_order(order_id)</TD></TR><TR><TD ALIGN="LEFT">+cancel_order(order_id)</TD></TR><TR><TD ALIGN="LEFT">+delete_order(order_id)</TD></TR></TABLE>>];
DataError [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#536277"><TR><TD BGCOLOR="#DCE6F2" CELLPADDING="8"><B>«exceção» DataError</B></TD></TR></TABLE>>];
ExcelDB -> Pedido [dir=forward style=dashed label="persiste"];
ExcelDB -> Configuracao [dir=forward style=dashed label="carrega"];
ExcelDB -> DataError [dir=forward style=dashed label="sinaliza erros"];
Fornecedor -> Produto [taillabel="0..1" headlabel="0..*" labeldistance=1.6 label="fornece" ];
Cliente -> Pedido [taillabel="1" headlabel="0..*" labeldistance=1.6 label="realiza" ];
Filial -> Pedido [taillabel="1" headlabel="0..*" labeldistance=1.6 label="recebe" ];
Pedido -> ItemPedido [taillabel="1" headlabel="1..*" labeldistance=1.6 label="contém" dir=back arrowtail=diamond];
Produto -> ItemPedido [taillabel="1" headlabel="0..*" labeldistance=1.6 label="referencia" ];
    }
